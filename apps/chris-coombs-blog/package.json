{
  "name": "nim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "NODE_ENV=development npx dotenv -e .env.development -- npx prisma db push",
    "db:push:production": "npx dotenv -e .env.production -- npx prisma db push",
    "db:migrate": " npx dotenv -e .env.production -- npx prisma migrate dev",
    "db:studio": " npx dotenv -e .env.production -- npx prisma studio",
    "dev:development": "NODE_ENV=development  npx dotenv -e .env.development -- npm run dev",
    "dev:production": "NODE_ENV=development npx dotenv -e .env.production -- npm run dev",
    "build:development": "NODE_ENV=development npx dotenv -e .env.development -- npm run build",
    "build:production": "NODE_ENV=production npx dotenv -e .env.production --npm run build",
    "start:development": "NODE_ENV=development  npx dotenv -e .env.development -- npm run start",
    "start:production": "NODE_ENV=production  npx dotenv -e .env.production -- npm run start"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/typography": "^0.5.15",
    "cheerio": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^16.0.0",
    "mermaid": "^11.8.1",
    "motion": "^11.15.0",
    "next": "15.1.1",
    "next-cloudinary": "^6.16.0",
    "next-themes": "^0.4.4",
    "playwright": "^1.53.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.19.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5"
  }
}
